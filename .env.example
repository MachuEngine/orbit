# Orbit 로컬 개발용 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 실제 값이 아닌 자리표시자만 둔다.

# ── 데이터베이스 (세부 설계 D4-1: PostgreSQL + pgvector, 후보) ──
DATABASE_URL=postgresql://orbit:change-me@localhost:5432/orbit

# ── LLM 게이트웨이 (세부 설계 D9-4: OpenRouter) ──
# 키 이름은 아래 'LLM 설정' 절을 따른다. 실험에서는 고정 모델 ID만 쓴다 (D9-3).

# ── Google 로그인 (ADR-0016 §1, orbit.core.config.Settings) ──
# ORBIT_ENV=dev가 아니면 아래 다섯 값이 모두 있어야 API가 시작된다. 실제 값은 secrets/.env에 둔다.
# 리디렉션 주소는 Google Cloud 콘솔의 "승인된 리디렉션 URI"와 정확히 같아야 한다.
ORBIT_GOOGLE_CLIENT_ID=
ORBIT_GOOGLE_CLIENT_SECRET=
ORBIT_GOOGLE_REDIRECT_URI=https://orbit.example.invalid/api/auth/google/callback
# 임시 로그인 쿠키 서명 키(32바이트 이상). 값을 직접 쓰거나 파일 경로를 준다. 둘 다 있으면 값이 우선한다.
ORBIT_SESSION_SIGNING_KEY=
# ORBIT_SESSION_SIGNING_KEY_FILE=./secrets/session-signing-key
# 로그인을 허용할 이메일(쉼표 구분). 비어 있으면 아무도 로그인하지 못한다.
ORBIT_LOGIN_ALLOWED_EMAILS=
# 테스트용 Google 엔드포인트 재정의(https만): ORBIT_GOOGLE_AUTH_URL, ORBIT_GOOGLE_TOKEN_URL, ORBIT_GOOGLE_JWKS_URL

# ── Google 계정 연결 (ADR-0016 §2, 로그인과 같은 클라이언트 ID·비밀을 쓴다) ──
# 연결 콜백 주소는 Google Cloud 콘솔의 "승인된 리디렉션 URI"에 로그인 콜백과 함께 등록한다.
# 비우면 ORBIT_GOOGLE_REDIRECT_URI의 /api/auth/google/callback을 /api/connections/google/callback으로 바꾼 값을 쓴다.
ORBIT_GOOGLE_CONNECT_REDIRECT_URI=https://orbit.example.invalid/api/connections/google/callback
# sim(기본): 합성 데이터 Sim 커넥터. google: 워크스페이스의 활성 Google 연결(연결 설정이 모두 있어야 시작).
ORBIT_CONNECTOR_MODE=sim
# 테스트용 철회 엔드포인트 재정의(https만): ORBIT_GOOGLE_REVOKE_URL

# ── 토큰 봉투 암호화 (D4-5: 로컬 개발은 파일 키) ──
# 키 파일은 secrets/ 아래에 두며 저장소에 포함하지 않는다.
# 생성: uv run --directory backend python -m orbit.crypto.keygen ../secrets/dev-data-key (권한 0600)
# 서버·워커는 backend/에서 실행되므로 저장소 루트 기준 경로가 아니라 절대 경로를 쓴다. 생성: cd backend && uv run python -m orbit.crypto.keygen <경로>
ORBIT_DATA_KEY_FILE=/절대/경로/secrets/dev-data-key

# ── LLM 설정 (orbit.core.config.LLMSettings) ──
# 실제 키는 secrets/.env에 둔다(secrets/는 커밋하지 않는다). 불러오기: set -a; source secrets/.env; set +a
# 제공자: openrouter(기본, ADR-0009) 또는 openai(모델 파일럿 임시, ADR-0014)
ORBIT_LLM_PROVIDER=openai
# 모델 ID는 `provider/model` 형식. 실험 기본 openai/gpt-6-luna(low), 실사용 openai/gpt-6.1-terra(low) — ADR-0015
ORBIT_LLM_MODEL_ID=openai/gpt-6-luna
# 추론 강도: none | low | medium | high (모델마다 지원 값이 다르다)
ORBIT_LLM_REASONING_EFFORT=low
# 추론 모델은 temperature를 지원하지 않을 수 있다. 기본 false(보내지 않음)
ORBIT_LLM_SEND_TEMPERATURE=false
ORBIT_LLM_ACCEPTED_RESPONSE_MODEL_IDS=

# OpenAI (ORBIT_LLM_PROVIDER=openai일 때 필수)
ORBIT_OPENAI_API_KEY=
# ORBIT_OPENAI_BASE_URL=https://api.openai.com/v1

# 비용 계산용 단가(1백만 토큰당 달러). 네 값은 함께 설정한다. 비우면 비용 미상으로 기록된다.
ORBIT_LLM_PRICE_INPUT_PER_MTOK=
ORBIT_LLM_PRICE_CACHED_INPUT_PER_MTOK=
ORBIT_LLM_PRICE_OUTPUT_PER_MTOK=
ORBIT_LLM_PRICE_SOURCE=

# OpenRouter (ORBIT_LLM_PROVIDER=openrouter일 때 필수)
ORBIT_OPENROUTER_API_KEY=
# 제공자 우선순위(쉼표 구분)
ORBIT_LLM_PROVIDER_ORDER=
