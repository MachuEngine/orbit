{
  "name": "orbit-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Orbit 데스크톱 셸 (macOS, Electron). 화면은 Orbit 서버 출처를 그대로 연다(ADR-0024).",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "1.65.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "11.0.7"
  }
}
