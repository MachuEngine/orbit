# backend/dev.env 예시: 로컬 개발·테스트용 환경 변수. compose.yml의 개발 전용 값과 같다.
# 이 파일의 비밀번호는 로컬 개발 전용 값이라 커밋해도 된다. 실제 API 키·운영 비밀번호는 넣지 않는다.
# 사용: set -a; source backend/dev.env; set +a
#
# 앱 런타임은 앱 역할(app_user), 마이그레이션은 소유자 역할(app_owner)로 접속한다.
# 개발 DB(app)와 통합 테스트 DB(app_test)를 나눈다. 테스트는 app_test의 스키마를 내렸다 올린다.
APP_ENV=dev
APP_DATABASE_URL=postgresql+psycopg://app_user:app_dev_user_only@localhost:55432/app
APP_MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:app_dev_owner_only@localhost:55432/app
APP_TEST_DATABASE_URL=postgresql+psycopg://app_user:app_dev_user_only@localhost:55432/app_test
APP_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:app_dev_owner_only@localhost:55432/app_test
# 외부 API 키는 값을 비워 둔다. 개발자가 로컬에서만 채운다.
APP_EXTERNAL_API_KEY=
