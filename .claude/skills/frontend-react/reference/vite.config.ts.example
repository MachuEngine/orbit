// frontend/vite.config.ts 예시.
import react from "@vitejs/plugin-react";
import { defineConfig } from "vitest/config";

export default defineConfig({
  plugins: [react()],
  // 글꼴 파일을 CSS에 끼워 넣지 않고 따로 내려받게 한다(unicode-range 분할 글꼴이 의미를 가진다).
  build: { assetsInlineLimit: 0 },
  server: {
    // 개발 서버가 내줄 수 있는 파일을 frontend/와 필요한 폴더(예: 디자인 토큰 원본)로 제한한다.
    // deny는 vite 기본값(.env*, 인증서, .git)에 비공개 문서와 비밀 파일 패턴을 더한 것이다.
    fs: {
      allow: [".", "../docs/brand"],
      deny: [
        ".env",
        ".env.*",
        "*.{crt,pem,key}",
        "**/.git/**",
        "**/private-docs/**",
        "**/secrets/**",
      ],
    },
    // 개발 중에도 웹과 API를 같은 출처로 쓴다. 포트는 백엔드 개발 서버에 맞춘다.
    proxy: {
      "/api": "http://127.0.0.1:8000",
    },
  },
  test: {
    environment: "jsdom",
    setupFiles: ["./src/test/setup.ts"],
    restoreMocks: true,
    // 스타일 규칙을 테스트하려고 CSS 원문(?raw)을 읽을 때 필요하다. 기본값은 CSS를 빈 문자열로 바꾼다.
    css: true,
  },
});
