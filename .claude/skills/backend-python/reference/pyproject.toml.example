# backend/pyproject.toml 예시. `app`은 패키지 이름, `<버전>`은 설치할 때 정한 버전으로 바꾼다.
# 의존성은 `uv add --directory backend <패키지>`로 추가하면 버전 하한이 자동으로 들어간다.
# 동작이 버전에 민감한 라이브러리(DB 드라이버, ORM, 작업 큐)는 `==`로 고정하는 편이 안전하다.
[project]
name = "app-backend"
version = "0.0.0"
requires-python = ">=3.12,<3.13"
dependencies = [
    "alembic>=<버전>",
    "fastapi>=<버전>",
    "psycopg[binary,pool]==<버전>",
    "pydantic-settings>=<버전>",
    "sqlalchemy[asyncio]==<버전>",
    "uvicorn>=<버전>",
    # 선택: 작업 큐를 쓰면 "procrastinate==<버전>"
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/app"]

[dependency-groups]
dev = [
    "httpx>=<버전>",          # FastAPI TestClient
    "mypy>=<버전>",
    "pytest>=<버전>",
    "pytest-asyncio>=<버전>",
    "ruff>=<버전>",
]

[tool.ruff]
line-length = 100
target-version = "py312"
src = ["src", "tests"]

[tool.ruff.lint]
# E/F 기본, I import 정렬, UP 최신 문법, B 버그 패턴, SIM 단순화, S 보안, DTZ 시간대 없는 datetime
select = ["E", "F", "I", "UP", "B", "SIM", "S", "DTZ"]

[tool.ruff.lint.per-file-ignores]
# 테스트는 assert와 고정 합성 비밀번호를 쓴다.
"tests/**" = ["S101", "S105", "S106"]
# 시계 구현만 실제 시각을 읽는다.
"src/app/core/clock.py" = ["DTZ"]

[tool.mypy]
python_version = "3.12"
strict = true
files = ["src", "tests", "migrations"]
mypy_path = "src"
plugins = ["pydantic.mypy"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
markers = ["integration: 실제 PostgreSQL이 필요한 통합 테스트"]
