# Orbit 로컬 개발용 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 실제 값이 아닌 자리표시자만 둔다.

# ── 데이터베이스 (세부 설계 D4-1: PostgreSQL + pgvector, 후보) ──
DATABASE_URL=postgresql://orbit:change-me@localhost:5432/orbit

# ── LLM 게이트웨이 (세부 설계 D9-4: OpenRouter) ──
OPENROUTER_API_KEY=
# 실험에서는 날짜가 붙은 고정 모델 ID만 쓴다 (D9-3). 미결정.
ORBIT_MODEL_ID=

# ── Google OAuth (커넥터 단계 H2에서 사용) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── 토큰 봉투 암호화 (D4-5: 로컬 개발은 파일 키) ──
# 키 파일은 secrets/ 아래에 두며 저장소에 포함하지 않는다.
ORBIT_DATA_KEY_FILE=./secrets/dev-data-key
