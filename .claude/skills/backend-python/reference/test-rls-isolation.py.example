"""backend/tests/integration/test_note_isolation.py 예시: RLS 격리 테스트.

테넌트 데이터 테이블마다 같은 네 가지를 확인한다. 데이터는 모두 합성 값이다.
`make_tenant`, `insert_note`는 프로젝트 테스트 지원 코드에 만든다(테넌트 생성·정리 포함).
"""

import uuid
from collections.abc import Callable

import pytest
from sqlalchemy import Engine, text
from sqlalchemy.exc import DBAPIError

from app.db.session import SyncDatabase

COUNT_NOTES = text("SELECT count(*) FROM note")


def test_other_tenant_rows_are_invisible(
    sync_db: SyncDatabase,
    make_tenant: Callable[[], uuid.UUID],
    insert_note: Callable[[uuid.UUID], None],
) -> None:
    a, b = make_tenant(), make_tenant()
    insert_note(b)
    with sync_db.tenant_session(a) as s:
        assert s.execute(COUNT_NOTES).scalar_one() == 0


def test_cannot_write_into_other_tenant(
    sync_db: SyncDatabase, make_tenant: Callable[[], uuid.UUID]
) -> None:
    a, b = make_tenant(), make_tenant()
    with pytest.raises(DBAPIError), sync_db.tenant_session(a) as s:  # WITH CHECK 위반
        s.execute(
            text(
                "INSERT INTO note (id, tenant_id, body, created_at)"
                " VALUES (gen_random_uuid(), :b, '합성 메모', now())"
            ),
            {"b": b},
        )


def test_no_tenant_setting_sees_nothing(
    raw_engine: Engine,
    make_tenant: Callable[[], uuid.UUID],
    insert_note: Callable[[uuid.UUID], None],
) -> None:
    insert_note(make_tenant())
    with raw_engine.connect() as conn:
        assert conn.execute(COUNT_NOTES).scalar_one() == 0


def test_setting_does_not_leak_to_next_transaction(
    raw_engine: Engine,
    make_tenant: Callable[[], uuid.UUID],
    insert_note: Callable[[uuid.UUID], None],
) -> None:
    a = make_tenant()
    insert_note(a)
    db = SyncDatabase(raw_engine)  # 연결 1개짜리 풀: 다음 트랜잭션이 같은 연결을 받는다
    with db.tenant_session(a) as s:
        assert s.execute(COUNT_NOTES).scalar_one() == 1
    with raw_engine.connect() as conn:
        assert conn.execute(COUNT_NOTES).scalar_one() == 0
